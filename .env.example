# Скопіювати в .env (уже в .gitignore) і заповнити реальними значеннями.
# НІКОЛИ не комітити .env.

TELEGRAM_BOT_TOKEN=1234567890:AA...  # від @BotFather
TELEGRAM_ALLOWED_USER_ID=00000000    # твій Telegram user ID (напр. від @userinfobot)
DEEPSEEK_API_KEY=sk-...              # той самий ключ, що вже в agent.py

# Опційно:
CLAUDE_PERMISSION_MODE=plan          # plan (безпечно) | acceptEdits | bypassPermissions (ризик)
CLAUDE_CWD=/data/data/com.termux/files/home/AgentReachProject
